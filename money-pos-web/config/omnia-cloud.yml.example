# Copy this file to %ProgramData%\VanaPOS\config\omnia-cloud.yml on the POS computer.
# Do not place real values in the installation directory, Git, MariaDB, or the admin web UI.
# Restrict the copied file to SYSTEM and local Administrators.
omnia:
  cloud:
    sync:
      enabled: false
      endpoint: https://omnia-cloud.example.workers.dev/internal/v1/member-snapshots:batch
      store-id: store-001
      tenant-id: 0
      key-id: moneypos-sync-001
      signing-secret-base64: REPLACE_WITH_WORKER_MATCHING_BASE64_SECRET
      search-hmac-secret-base64: REPLACE_WITH_BASE64_SEARCH_HMAC_SECRET
      fixed-delay-ms: 60000
      initial-backfill-enabled: false
      initial-backfill-batch-size: 500
